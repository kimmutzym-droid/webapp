# 로컬에서 frontend/backend를 따로 띄울 때는 이 값(5173) 그대로 사용.
# 배포(단일 서비스로 합쳐 실행) 시에는 APP_BASE_URL과 FRONTEND_URL을 실제 배포 주소로 동일하게 바꾸세요
# (예: 둘 다 https://your-app.onrender.com)
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

GEMINI_API_KEY=

DB_PATH=./data/app.db
SESSION_SECRET=change-me
